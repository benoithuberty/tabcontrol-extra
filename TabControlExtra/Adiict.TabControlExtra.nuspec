<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Adiict.TabControlExtra</id>
    <version>$version$</version>
    <title>Adiict.TabControlExtra</title>
    <authors>Adiict</authors>
    <description>Replacement for the Microsoft .Net TabControl with advanced features. Supports net48, net8.0-windows and net10.0-windows.</description>
    <copyright>Benoit Huberty - Adiict</copyright>
    <projectUrl>https://github.com/benoithuberty/tabcontrol-extra</projectUrl>
    <license type="file">License.md</license>
    <readme>README.md</readme>
    <tags>winforms tabcontrol net48 net8 net10 windows</tags>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <dependencies>
      <group targetFramework="net48" />
      <group targetFramework="net8.0-windows7.0" />
      <group targetFramework="net10.0-windows7.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\License.md" target="" />
    <file src="..\README.md" target="" />
    <file src="bin\$configuration$\net48\Adiict.TabControlExtra.dll" target="lib\net48\" />
    <file src="bin\$configuration$\net8.0-windows\Adiict.TabControlExtra.dll" target="lib\net8.0-windows7.0\" />
    <file src="bin\$configuration$\net10.0-windows\Adiict.TabControlExtra.dll" target="lib\net10.0-windows7.0\" />
  </files>
</package>
