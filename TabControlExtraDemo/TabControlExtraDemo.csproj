<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Adiict.TabControlExtraDemo</AssemblyName>
    <RootNamespace>Adiict.UI.Forms</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>CSCustomTabControlDemo.Program</StartupObject>
    <Nullable>disable</Nullable>
    <!-- ImageList resources use a legacy serialisation path; suppress the informational warning. -->
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
    <!-- Platform-specific APIs are intentional: this project only targets windows TFMs. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TabControlExtra\TabControlExtra.csproj" />
  </ItemGroup>
</Project>
